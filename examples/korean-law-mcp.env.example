# 법제처 OpenAPI 인증키
# 발급: https://open.law.go.kr
LAW_OC=your-law-openapi-oc-key

# 기본값은 https입니다.
LAW_API_PROTOCOL=https

# 선택: 법제처 호출 Referer override
# LAW_REFERER=https://www.law.go.kr

# 선택: 국세청 판례 fallback 등 외부 HTTPS 프록시
# LAW_EXTERNAL_HTTPS_PROXY=http://proxy-host:8080

# 진단용으로만 사용하세요. 운영 상시 사용 금지.
# LAW_EXTERNAL_TLS_REJECT_UNAUTHORIZED=0
